# BIG (Be Independent Gal) - Environment Variables

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/[project-id]/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anonymous/publishable key (client-side safe)
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Server/Secret keys (Server-side ONLY - never expose to client!)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Server port for development
PORT=3000

# Node environment
NODE_ENV=development

# ============================================================================
# THIRD-PARTY SERVICES & AUTH
# ============================================================================

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
VITE_RESEND_API_KEY=

# ============================================================================
# NOTES
# ============================================================================
# - VITE_* variables are exposed to the browser (public)
# - NEXT_PUBLIC_* variables are also exposed to the browser (Vercel compatibility)
# - Variables without VITE_ or NEXT_PUBLIC_ prefix are private to the server
# - Keep API keys and secrets secure - never commit .env to version control
# - Copy this file to .env.local and fill in your actual values
