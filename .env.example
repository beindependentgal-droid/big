# BIG (Be Independent Gal) - Environment Variables

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/[project-id]/settings/api

# Your Supabase project URL
VITE_SUPABASE_URL=

# Your Supabase anonymous/publishable key (client-side safe)
# DO NOT use the service_key in the browser!
VITE_SUPABASE_PUBLISHABLE_KEY=

# Alternative naming (will fallback if above not set)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Server port for development
PORT=3000

# Node environment
NODE_ENV=development

# API host used by the frontend in development or production
# Example: http://localhost:3000 or https://api.big.example.com
VITE_API_BASE_URL=

# Optional frontend origin allowed by the backend CORS policy
# Example: http://localhost:5173 or https://big.example.com
FRONTEND_ORIGIN=

# ============================================================================
# THIRD-PARTY SERVICES
# ============================================================================

# Vercel Analytics
VITE_VERCEL_ANALYTICS_ID=

# Google AI/Gemini API
VITE_GOOGLE_GENAI_API_KEY=

# Email service (Resend)
VITE_RESEND_API_KEY=

# ============================================================================
# BUILD & DEPLOYMENT
# ============================================================================

# Build timestamp (auto-set in vite.config.ts, no need to configure)
VITE_BUILD_TIMESTAMP=

# Disable HMR for AI Studio or headless environments
DISABLE_HMR=false

# ============================================================================
# NOTES
# ============================================================================
# - VITE_* variables are exposed to the browser (public)
# - NEXT_PUBLIC_* variables are also exposed to the browser (Vercel compatibility)
# - Variables without VITE_ or NEXT_PUBLIC_ prefix are private to the server
# - Keep API keys and secrets secure - never commit .env to version control
# - Copy this file to .env.local and fill in your actual values
